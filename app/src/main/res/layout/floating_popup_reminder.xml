<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="700dp"
    android:orientation="vertical"
    android:background="#CCCCFF"
    android:layout_gravity="center"
    android:padding="25dp">

    <CheckBox
        android:id="@+id/checkBoxTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Imposta data e ora"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="Date And Time"
            android:layout_gravity="center"
            android:enabled="false"/>
        <Button
            android:id="@+id/selectDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:gravity="center"
            android:text="SELECT"
            android:enabled="false"/>

    </LinearLayout>

    <Switch
        android:id="@+id/switchOgniGiorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ripeti ogni giorno"
        android:enabled="false" />

    <Switch
        android:id="@+id/switchOgniSettimana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ripeti ogni settimana"
        android:enabled="false" />

    <CheckBox
        android:id="@+id/checkBoxGeo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Imposta geolocalizzazione"
        android:layout_marginTop="40dp"/>

    <EditText
        android:id="@+id/Latitudine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:hint="Latitudine"
        android:gravity="center"
        android:inputType="numberSigned|numberDecimal"
        android:enabled="false"
        />

    <EditText
        android:id="@+id/Longitudine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:hint="Longitudine"
        android:inputType="numberSigned|numberDecimal"
        android:enabled="false"/>


    <Button
        android:id="@+id/btn_maps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MAPS"
        android:enabled="false" />

    <EditText
        android:id="@+id/RaggioMetri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:hint="Raggio d'azione"
        android:inputType="number"
        android:enabled="false"
         />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        tools:ignore="ExtraText"
        >

        <RadioButton
            android:id="@+id/checkBoxEntrata"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:text="Entrata"
            android:enabled="false"/>

        <RadioButton
            android:id="@+id/checkBoxUscita"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:text="Uscita"
            android:enabled="false"/>

    </RadioGroup>



    <EditText
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:hint="Message"
        android:gravity="center"/>


    <ImageView
        android:id="@+id/btn_record"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_mic_black_48dp"
        android:layout_below="@+id/tv_record"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        />




    <Button
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Add"
        android:layout_gravity="center" />




</LinearLayout>
